{
  "name": "autophagy-backend",
  "version": "0.1.0",
  "description": "Behavioral waste detection and on-chain efficiency reputation for autonomous agent fleets",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "cluster:up": "node k8s/setup.mjs",
    "cluster:workloads": "kubectl apply -f k8s/namespace.yaml -f k8s/workloads/",
    "cluster:down": "kubectl delete -f k8s/workloads/ --ignore-not-found",
    "contracts:build": "npm --prefix contracts run build",
    "contracts:deploy": "node contracts/deploy.mjs",
    "test": "node --env-file=.env.test --import tsx --test \"src/**/*.test.ts\"",
    "contracts:test": "npm --prefix contracts run test"
  },
  "type": "module",
  "dependencies": {
    "@kubernetes/client-node": "^2.0.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "ethers": "^6.17.0",
    "express": "^5.2.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.4.0",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2"
  },
  "private": true
}
