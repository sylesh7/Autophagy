7a:["$","div",null,{"className":"storyblok-content","data-v-be5fd091":"","children":"A Digital Asset Treasury (DAT) is a public markets vehicle that holds and safeguards digital assets, like ETH, on behalf of investors, providing regulated access through institutional-grade custody and administration."}]
7b:["$","div",null,{"className":"faq-item","data-v-7640bd75":"","data-v-be5fd091":"","children":[["$","div",null,{"className":"header layout-flex","data-v-be5fd091":"","children":[["$","div",null,{"className":"eyebrow","data-v-be5fd091":"","children":"03"}],["$","div",null,{"className":"question","data-v-be5fd091":"","children":"How is Sharplink different from directly holding ETH?"}],["$","div",null,{"className":"icon-wrapper","data-v-be5fd091":"","children":["$","svg",null,{"className":"svg-plus icon","width":16,"height":16,"viewBox":"0 0 16 16","fill":"none","xmlns":"http://www.w3.org/2000/svg","data-v-be5fd091":"","children":[["$","path",null,{"d":"M8 1L8 15","stroke":"currentColor","strokeWidth":"1.25"}],["$","path",null,{"d":"M15 8L1 8","stroke":"currentColor","strokeWidth":"1.25"}]]}]}]]}],["$","div",null,{"className":"body","data-v-be5fd091":"","style":{"height":"0px"},"children":["$","div",null,{"className":"body__answer","data-v-be5fd091":"","children":["$","div",null,{"className":"storyblok-content","data-v-be5fd091":"","children":[["$","p",null,{"children":["$","span",null,{"children":"Holding ETH does not generate yield, and even when investors stake through exchanges, those platforms often take a substantial share of the rewards — sometimes as much as 35%, even when marketed as “no fee.” At Sharplink, 100% of staking yield accrues to shareholders. We do not skim rewards."}]}],["$","p",null,{"children":["$","span",null,{"children":"But the difference goes further. Through active management, DeFi participation, and accretive capital markets and corporate actions, we are continuously compounding ETH per share over time."}]}]]}]}]}]]}]
7c:["$","div",null,{"className":"faq-item","data-v-7640bd75":"","data-v-be5fd091":"","children":[["$","div",null,{"className":"header layout-flex","data-v-be5fd091":"","children":[["$","div",null,{"className":"eyebrow","data-v-be5fd091":"","children":"04"}],["$","div",null,{"className":"question","data-v-be5fd091":"","children":"How is Sharplink different from buying an ETF?"}],["$","div",null,{"className":"icon-wrapper","data-v-be5fd091":"","children":["$","svg",null,{"className":"svg-plus icon","width":16,"height":16,"viewBox":"0 0 16 16","fill":"none","xmlns":"http://www.w3.org/2000/svg","data-v-be5fd091":"","children":[["$","path",null,{"d":"M8 1L8 15","stroke":"currentColor","strokeWidth":"1.25"}],["$","path",null,{"d":"M15 8L1 8","stroke":"currentColor","strokeWidth":"1.25"}]]}]}]]}],["$","div",null,{"className":"body","data-v-be5fd091":"","style":{"height":"0px"},"children":["$","div",null,{"className":"body__answer","data-v-be5fd091":"","children":["$","div",null,{"className":"storyblok-content","data-v-be5fd091":"","children":["$","p",null,{"children":"Many ETFs only offer spot exposure without any extra yield. Additionally, while some ETF issuers are now permitted to stake ETH, they face structural constraints: to satisfy the Securities and Exchange Commission’s daily liquidity requirements, ETFs can realistically stake only about 50% of their holdings. Sharplink, by contrast, has staked 100% of its ETH since day one."}]}]}]}]]}]
7d:["$","div",null,{"className":"faq-item","data-v-7640bd75":"","data-v-be5fd091":"","children":[["$","div",null,{"className":"header layout-flex","data-v-be5fd091":"","children":[["$","div",null,{"className":"eyebrow","data-v-be5fd091":"","children":"05"}],["$","div",null,{"className":"question","data-v-be5fd091":"","children":"What does it mean to maximize ETH per share?"}],["$","div",null,{"className":"icon-wrapper","data-v-be5fd091":"","children":["$","svg",null,{"className":"svg-plus icon","width":16,"height":16,"viewBox":"0 0 16 16","fill":"none","xmlns":"http://www.w3.org/2000/svg","data-v-be5fd091":"","children":[["$","path",null,{"d":"M8 1L8 15","stroke":"currentColor","strokeWidth":"1.25"}],["$","path",null,{"d":"M15 8L1 8","stroke":"currentColor","strokeWidth":"1.25"}]]}]}]]}],["$","div",null,{"className":"body","data-v-be5fd091":"","style":{"height":"0px"},"children":["$","div",null,{"className":"body__answer","data-v-be5fd091":"","children":["$","div",null,{"className":"storyblok-content","data-v-be5fd091":"","children":["$","p",null,{"children":"Maximizing ETH per share focuses on growing the underlying ETH per public company share through native rewards and ETH-denominated returns, independent of ETH price movements. It also involves Sharplink using capital markets to raise funds and procure additional ETH on the spot market in an accretive fashion for shareholders."}]}]}]}]]}]
7e:["$","div",null,{"className":"faq-item","data-v-7640bd75":"","data-v-be5fd091":"","children":[["$","div",null,{"className":"header layout-flex","data-v-be5fd091":"","children":[["$","div",null,{"className":"eyebrow","data-v-be5fd091":"","children":"06"}],["$","div",null,{"className":"question","data-v-be5fd091":"","children":"Does Sharplink have gaming services?"}],["$","div",null,{"className":"icon-wrapper","data-v-be5fd091":"","children":["$","svg",null,{"className":"svg-plus icon","width":16,"height":16,"viewBox":"0 0 16 16","fill":"none","xmlns":"http://www.w3.org/2000/svg","data-v-be5fd091":"","children":[["$","path",null,{"d":"M8 1L8 15","stroke":"currentColor","strokeWidth":"1.25"}],["$","path",null,{"d":"M15 8L1 8","stroke":"currentColor","strokeWidth":"1.25"}]]}]}]]}],["$","div",null,{"className":"body","data-v-be5fd091":"","style":{"height":"0px"},"children":["$","div",null,{"className":"body__answer","data-v-be5fd091":"","children":["$","div",null,{"className":"storyblok-content","data-v-be5fd091":"","children":["$","p",null,{"children":"Sharplink does not have direct gaming services. In addition to the core Ethereum Digital Asset Treasury strategy, Sharplink operates an online affiliate marketing business that connects regulated gaming operators with potential customers. This operating business provides additional commercial activity alongside initiatives in the digital asset treasury sector."}]}]}]}]]}]
